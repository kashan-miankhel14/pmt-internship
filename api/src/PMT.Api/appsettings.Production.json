{
  "Ai": {
    "ChatProvider": "Ollama",
    "AutoReindex": {
      "IsEnabled": true,
      "IntervalMinutes": 15
    }
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "ChatModel": "llama3.2",
    "EmbeddingModel": "nomic-embed-text"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "HttpsRedirection": {
    "Enabled": true
  }
}
