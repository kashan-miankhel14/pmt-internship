{
  "Jwt": {
    "Issuer": "PMT.Api",
    "Audience": "PMT.Web"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Ai": {
    "ChatProvider": "Ollama",
    "MaxTurnSeconds": 180,
    "AllowTextToolCalls": false,
    "AutoReindex": {
      "IsEnabled": false,
      "IntervalMinutes": 15
    }
  },
  "Gemini": {
    "ChatModel": "gemini-3.5-flash-lite",
    "MaxSteps": 6,
    "RequestTimeoutSeconds": 60
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "ChatModel": "nemotron-3-nano:30b-cloud",
    "EmbeddingModel": "nomic-embed-text",
    "MaxSteps": 5,
    "RequestTimeoutSeconds": 120,
    "ConnectTimeoutSeconds": 5,
    "SlowRequestLogThresholdMs": 10000
  },
  "Authentication": {
    "AllowHttpMetadata": true
  },
  "HttpsRedirection": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
