# Copy to .env for local reference. Do not commit a populated .env file.
# .NET reads these names through the double-underscore configuration convention.
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Server=localhost;Database=PMT;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True
Jwt__Issuer=PMT.Api
Jwt__Audience=PMT.Web
Jwt__SigningKey=REPLACE_WITH_RANDOM_32_PLUS_BYTE_KEY
Cors__AllowedOrigins__0=http://localhost:3000
Authentication__AllowHttpMetadata=true
Gemini__ApiKey=
Ollama__BaseUrl=http://localhost:11434
BootstrapAdmin__Email=admin@example.com
BootstrapAdmin__DisplayName=System Administrator
BootstrapAdmin__Password=REPLACE_WITH_STRONG_PASSWORD_12_PLUS_CHARS

# Next.js public build/runtime settings. NEXT_PUBLIC_* values are safe to expose.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5133/api/v1
NEXT_PUBLIC_HUB_URL=http://localhost:5133/hubs/notifications
BASEPATH=
